# Copy to .env — the API refuses to start without DATABASE_URL
# Supabase pooler (transaction) connection string:
#   Dashboard -> Project Settings -> Database -> Connection string -> "Transaction pooler"
#   e.g. postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

DATABASE_URL=

# Optional: first user who signs up (or the very first user ever) becomes admin
ADMIN_EMAIL=

# Optional: bearer token used by the read-only cross-app endpoints
#   GET /api/credits/balances
#   GET /api/messages/shared
READ_TOKEN=

# Comma-separated list of origins allowed to call the cross-app endpoints (empty = disallow cross-origin)
ALLOWED_ORIGINS=

# Optional: Twilio SMS sending
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: Anthropic key for AI message generation (POST /api/generate-message)
ANTHROPIC_API_KEY=

# Optional: skip the boot-time schema setup (schema already exists)
# SKIP_SCHEMA=1

# HTTP port
PORT=8080