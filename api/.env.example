# Copy to .env — the API refuses to start without DATABASE_URL
# Supabase pooler (transaction) connection string:
#   Dashboard -> Project Settings -> Database -> Connection string -> "Transaction pooler"
#   e.g. postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

DATABASE_URL=

# Optional: first user who signs up (or the very first user ever) becomes admin
ADMIN_EMAIL=

# Server-side secret for cross-app reads (leave empty to deny all):
#   GET /api/credits/balances
#   GET /api/messages/shared
#
# JSON object mapping one opaque bearer token to exactly one owner_user_id:
#   {"REPLACE_WITH_TOKEN_A":"owner-id-a","REPLACE_WITH_TOKEN_B":"owner-id-b"}
# Tokens are opaque strings with no fixed format (any non-empty string works);
# use a strong random value, e.g. openssl rand -hex 32
# The owner id is resolved from the token only; never from query/body parameters.
# Malformed JSON fails closed. Legacy READ_TOKEN is not supported.
CROSS_APP_TOKENS_JSON=

# Canonical public browser origin (exact scheme://host[:port], no wildcard/path).
# Used for credentialed CORS and CSRF. Set this in production behind a proxy.
PUBLIC_ORIGIN=

# Exact origins for cross-app bearer GET reads only (empty = disallow cross-origin).
# Never use '*': CORS is reflected only for exact entries and never sends cookies.
# This list is NOT used for CSRF.
ALLOWED_ORIGINS=

# Additional exact browser origins allowed for credentialed CORS and cookie-authenticated
# mutations (POST/PUT/PATCH/DELETE). Empty means same-origin/PUBLIC_ORIGIN only.
FIRST_PARTY_ORIGINS=

# Explicit Express trust-proxy setting. Empty trusts no x-forwarded-* headers.
# Use a hop count (1) or a comma-separated proxy address list behind a known proxy.
TRUST_PROXY=

# Force Secure on session cookies outside NODE_ENV=production (1/true)
COOKIE_SECURE=

# Temporary: accept Authorization bearer tokens for first-party session lookup.
# This never writes tokens to browser storage. Remove after clients use cookies.
ALLOW_LEGACY_BEARER_SESSION=

# Optional: Twilio SMS sending
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: Anthropic key for AI message generation (POST /api/generate-message)
ANTHROPIC_API_KEY=

# Optional: skip the boot-time schema setup (schema already exists)
# SKIP_SCHEMA=1

# HTTP port
PORT=8080